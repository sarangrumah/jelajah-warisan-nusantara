{
  "name": "heritage-museum-backend",
  "version": "1.0.0",
  "description": "Backend API for Heritage Museum application",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "start:production": "NODE_ENV=production node dist/server.js",
    "dev:production": "NODE_ENV=production tsx watch src/server.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:translations": "tsx src/scripts/migrate-translations.ts",
    "add:ui-translations": "tsx src/scripts/add-ui-translations.ts",
    "add:all-ui-translations": "tsx src/scripts/add-all-ui-translations.ts",
    "seed:ui-translations": "tsx src/scripts/seed-ui-translations-from-i18n.ts",
    "test-db": "tsx src/scripts/test-db-connection.ts",
    "fix-password": "tsx src/scripts/fix-admin-password.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "pg": "^8.11.3",
    "sharp": "^0.35.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

// test-frontend-backend.js - Test frontend to backend connectivity
const http = require('http');

console.log('🧪 Testing Frontend to Backend API Connectivity');
console.log('================================================\n');

// Test 1: Backend health check
async function testBackendHealth() {
    console.log('1. Testing Backend Health Check...');
    
    return new Promise((resolve) => {
        const req = http.get('http://localhost:3000/api/health', (res) => {
            let data = '';
            res.on('data', chunk => data += chunk);
            res.on('end', () => {
                if (res.statusCode === 200) {
                    console.log('✅ Backend Health Check: PASSED');
                    console.log('📄 Response:', data);
                    resolve(true);
                } else {
                    console.log('❌ Backend Health Check: FAILED');
                    console.log('📄 Status:', res.statusCode);
                    console.log('📄 Response:', data);
                    resolve(false);
                }
            });
        });
        
        req.on('error', (err) => {
            console.log('❌ Backend Health Check: FAILED');
            console.log('❌ Error:', err.message);
            console.log('💡 Backend may not be running on localhost:3000');
            resolve(false);
        });
        
        req.setTimeout(5000, () => {
            console.log('⏰ Backend Health Check: TIMEOUT');
            resolve(false);
        });
    });
}

// Test 2: Test tb_company endpoint
async function testTbCompany() {
    console.log('\n2. Testing tb_company endpoint...');
    
    return new Promise((resolve) => {
        const options = {
            hostname: 'localhost',
            port: 3000,
            path: '/api/tb_company',
            method: 'GET',
            headers: {
                'Accept': 'application/json'
            }
        };
        
        const req = http.request(options, (res) => {
            let data = '';
            res.on('data', chunk => data += chunk);
            res.on('end', () => {
                if (res.statusCode === 200) {
                    try {
                        const jsonData = JSON.parse(data);
                        console.log('✅ tb_company Endpoint: PASSED');
                        console.log('📊 Records returned:', jsonData.length);
                        console.log('📄 Sample record:', JSON.stringify(jsonData[0], null, 2));
                        resolve(true);
                    } catch (err) {
                        console.log('❌ tb_company Endpoint: INVALID JSON');
                        console.log('📄 Response:', data.substring(0, 200));
                        resolve(false);
                    }
                } else {
                    console.log('❌ tb_company Endpoint: FAILED');
                    console.log('📄 Status:', res.statusCode);
                    console.log('📄 Response:', data);
                    resolve(false);
                }
            });
        });
        
        req.on('error', (err) => {
            console.log('❌ tb_company Endpoint: FAILED');
            console.log('❌ Error:', err.message);
            resolve(false);
        });
        
        req.setTimeout(5000, () => {
            console.log('⏰ tb_company Endpoint: TIMEOUT');
            req.destroy();
            resolve(false);
        });
        
        req.end();
    });
}


# Development Environment Configuration
# This file is for local development settings

# API Configuration - LOCAL DEVELOPMENT API
VITE_API_URL=http://localhost:3000
VITE_APP_ENV=development

# SEO and Analytics - Disabled in development
VITE_GA_TRACKING_ID=
VITE_GTM_ID=

# CDN and Asset Optimization - Disabled in development
VITE_CDN_URL=
VITE_IMAGE_OPTIMIZATION=false

# Security - Relaxed for development
VITE_ENABLE_CSP=false
VITE_SECURITY_HEADERS=true

# Performance
VITE_ENABLE_PWA=false
VITE_CACHE_VERSION=dev

# Monitoring - Disabled in development
VITE_ENABLE_ERROR_TRACKING=false
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Content Security - Allow localhost for development
VITE_ALLOWED_DOMAINS=localhost:3000,127.0.0.1:3000,localhost:5173,127.0.0.1:5173
# Production Environment Configuration
# This file is for production deployment settings

# API Configuration - PRODUCTION API
VITE_API_URL=https://api.museumcagarbudaya.kemenbud.go.id
VITE_APP_ENV=production

# SEO and Analytics
VITE_GA_TRACKING_ID=GA_MEASUREMENT_ID
VITE_GTM_ID=GTM-XXXXXXX

# CDN and Asset Optimization
VITE_CDN_URL=https://cdn.museumcagarbudaya.kemenbud.go.id
VITE_IMAGE_OPTIMIZATION=true

# Security
VITE_ENABLE_CSP=true
VITE_SECURITY_HEADERS=true

# Performance
VITE_ENABLE_PWA=true
VITE_CACHE_VERSION=1.0.0

# Monitoring
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Content Security - PRODUCTION DOMAINS ONLY
VITE_ALLOWED_DOMAINS=museumcagarbudaya.kemenbud.go.id,kemenbud.go.id,cdn.museumcagarbudaya.kemenbud.go.id
